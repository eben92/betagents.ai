# Copy to .env.local and fill in.
#
# Mock mode needs the model block and nothing else. Everything left blank below
# degrades gracefully: no Sheets means an in-memory store, no Telegram means no
# reports, no dashboard token means the dashboard stays off.
#
# Every tuning knob has a working default and is deliberately not here. The full
# list is in the README under "All settings".

# --- Models ----------------------------------------------------------------
# provider:model-id. Mix providers freely — one per agent, no code depends on it.
# anthropic | openai | google | deepseek are built in. Any other name works as an
# OpenAI-compatible endpoint via <NAME>_BASE_URL and <NAME>_API_KEY.
MODEL_CONTROL=deepseek:deepseek-chat
MODEL_RESEARCH=deepseek:deepseek-chat
MODEL_PLANNER=deepseek:deepseek-reasoner
MODEL_REVIEWER=deepseek:deepseek-reasoner
MODEL_EXECUTION=deepseek:deepseek-chat
MODEL_WATCHER=deepseek:deepseek-chat

DEEPSEEK_API_KEY=

# --- Basics ----------------------------------------------------------------
# Defines the betting day and the midnight roll-over.
TIMEZONE=Africa/Accra
CURRENCY=GHS

# mock = simulated bookmaker, no real money, no browser. Start here.
# live = real account, real money.
BETTING_MODE=mock

# --- Google Sheets ---------------------------------------------------------
# All persistent storage. From your service-account JSON key, plus the id in the
# spreadsheet URL. Share the sheet with the service account as an Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Telegram --------------------------------------------------------------
# BOT_TOKEN from @BotFather.
# ALLOWED_USER_IDS is your numeric user id, not a @username — message
# @userinfobot to get it. CHAT_ID: message your bot, then read `message.chat.id`
# from https://api.telegram.org/bot<BOT_TOKEN>/getUpdates.
# An empty allow-list denies everyone, on purpose.
#
# WEBHOOK_SECRET_TOKEN is a random string you invent and also pass to
# setWebhook; Telegram echoes it back so forged requests are rejected.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# --- Dashboard -------------------------------------------------------------
# Any long random string. Disabled, not public, while this is blank.
DASHBOARD_TOKEN=

# ===========================================================================
# LIVE BETTING — ignored while BETTING_MODE=mock
# ===========================================================================

# Any bookmaker. Elements are found by visible label, so this is all the code
# knows about the site; see the README for the optional label overrides.
OPERATOR=sportybet
OPERATOR_BASE_URL=
OPERATOR_USERNAME=
OPERATOR_PASSWORD=

# The page listing a sport's upcoming matches. `{sport}` is substituted with
# football, basketball, cricket or tennis.
OPERATOR_SPORTS_PATH=/sports/{sport}

# ---------------------------------------------------------------------------
# THE FIXTURE CATALOGUE — where the day's games and prices are read from
# ---------------------------------------------------------------------------
# This is the card the system researches from: what is on today and what markets
# are offered, so research never has to go hunting for fixtures. It is separate
# from the account above because reading a listing is not betting on it. Nothing
# is ever staked here; bets go only to OPERATOR_*.
#
# Leave FIXTURE_SOURCE_URL empty to use the staking operator's own card.
#
#   FIXTURE_SOURCE_URL=https://sports.bet9ja.com
#   FIXTURE_SOURCE=bet9ja
#   FIXTURE_SOURCE_SPORTS_PATH=/sports/{sport}
#
# If a path does not land on the listings, the Execution agent navigates by the
# sport's visible name instead — no selector for any site is compiled in.
FIXTURE_SOURCE_URL=
FIXTURE_SOURCE=
FIXTURE_SOURCE_SPORTS_PATH=
